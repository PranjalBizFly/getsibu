# GetSibu website — environment variables. Copy to .env.local for local work; never commit real values.
# No secrets are needed to build the site.

# "production" enables indexing (robots, meta robots, sitemap reference) and HSTS on an HTTPS origin.
# Leave unset (or any other value) for local development and previews: pages are noindex and
# robots.txt disallows everything.
SITE_ENV=

# Canonical origin, without a trailing slash. Required when SITE_ENV=production; used for canonical
# URLs, the sitemap, robots.txt, Open Graph URLs and structured data. Public (inlined at build time).
NEXT_PUBLIC_SITE_URL=

# Origin of the GetSibu web app for "Start free" (/signup) and "Sign In" (/login). Defaults to
# https://getsibu.com, where the app runs today. Set it if the app moves to its own origin
# (content/architecture/route-decisions.ts). Public.
NEXT_PUBLIC_APP_ORIGIN=

# Contact form (server-only; never exposed to the browser). The form appears on /contact only when
# both are set. CONTACT_FORM_ENDPOINT receives a JSON POST and must be HTTPS in production.
CONTACT_FORM_ENDPOINT=
CONTACT_FORM_PRIVACY_URL=
